# 키는 .env.local 의 OPENAI_API_KEY 에 넣으세요 (서버에서만 읽음)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# 신뢰도가 이 값보다 낮으면 사용자에게 유형 재확인 요청
MIN_CONFIDENCE=0.6

# ---- 실제 접수: 담당 기관 민원 메일 전송 (모두 설정하면 모의 접수 대신 실제 메일 발송) ----
# 수신 주소는 서버 설정으로만 지정됩니다 (사용자 입력 불가). 여러 개면 쉼표로 구분.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
REPORT_TO_EMAIL=
MAIL_MAX_PER_HOUR=10
